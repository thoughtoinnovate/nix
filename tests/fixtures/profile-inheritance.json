{
  "schemaVersion": 4,
  "distribution": {
    "name": "fixture"
  },
  "defaults": {
    "profile": "child"
  },
  "profiles": {
    "base": {
      "extends": null,
      "shells": [
        "zsh"
      ],
      "primaryShell": "zsh",
      "dotfiles": [
        "common",
        "nvim"
      ],
      "packages": {
        "nix": [
          "jq"
        ]
      },
      "plugins": {
        "fixture-plugin": {
          "enabled": true,
          "items": ["approved-app"]
        }
      },
      "platforms": {
        "macos": {
          "packages": {
            "nix": [
              {
                "name": "claude-code",
                "allowUnfree": true
              }
            ],
            "homebrew": {
              "formulae": [
                "vault"
              ]
            }
          }
        },
        "linux": {
          "distributions": {
            "ubuntu": {
              "packages": {
                "apt": [
                  "curl"
                ]
              }
            }
          }
        }
      }
    },
    "child": {
      "extends": "base",
      "exclude": {
        "dotfiles": [
          "nvim"
        ],
        "packages": {
          "nix": [
            "jq"
          ]
        }
      },
      "dotfiles": [
        "work-nvim"
      ],
      "packages": {
        "nix": [
          "ripgrep"
        ]
      }
    },
    "disabled": {
      "extends": "base",
      "plugins": {
        "fixture-plugin": {
          "enabled": false
        }
      }
    }
  }
}
